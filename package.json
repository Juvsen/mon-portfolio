    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "axe-core": "^4.14.0",
    "eslint": "^8.57.0",
