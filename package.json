    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.446.0",
    "maath": "^0.10.8",
    "motion": "^14.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
